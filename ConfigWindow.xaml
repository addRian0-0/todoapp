<Window x:Class="Notitas.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración" Width="860" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI, Tahoma, Arial" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== Left: appearance & export ===== -->
            <StackPanel Grid.Column="0">
                <TextBlock Text="Apariencia" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <TextBlock Text="Tema" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button x:Name="LightBtn" Style="{StaticResource FlatButton}" Padding="16,8" Click="Light_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSun}"/>
                            <TextBlock Text="Claro" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DarkBtn" Style="{StaticResource FlatButton}" Padding="16,8" Margin="8,0,0,0" Click="Dark_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMoon}"/>
                            <TextBlock Text="Oscuro" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="Color de tema" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel x:Name="Swatches" Margin="0,0,0,4"/>
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="R" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Slider x:Name="SlR" Grid.Row="0" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" ValueChanged="Rgb_Changed"/>
                    <TextBlock x:Name="ValR" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="G" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Slider x:Name="SlG" Grid.Row="1" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" ValueChanged="Rgb_Changed"/>
                    <TextBlock x:Name="ValG" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
                    <TextBlock Text="B" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource TextSecondary}"/>
                    <Slider x:Name="SlB" Grid.Row="2" Grid.Column="1" Maximum="255" VerticalAlignment="Center"
                            IsMoveToPointEnabled="True" ValueChanged="Rgb_Changed"/>
                    <TextBlock x:Name="ValB" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" TextAlignment="Right"/>
                </Grid>
                <DockPanel Margin="0,4,0,14">
                    <TextBlock Text="HEX" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0"/>
                    <Border x:Name="AccentPreview" DockPanel.Dock="Right" Width="28" Height="28" CornerRadius="6" Margin="8,0,0,0"/>
                    <TextBox x:Name="HexBox" Padding="6,5" Background="{DynamicResource PanelBg}"
                             Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                             TextChanged="HexBox_TextChanged"/>
                </DockPanel>

                <TextBlock Text="Exportación" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,12"/>
                <TextBlock Text="Carpeta de exportación por defecto" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Content="Cambiar carpeta" Style="{StaticResource FlatButton}"
                            Margin="8,0,0,0" Click="PickFolder_Click"/>
                    <TextBlock x:Name="ExportFolderText" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                </DockPanel>

                <TextBlock Text="Datos locales" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,12"/>
                <TextBlock x:Name="DbPathText" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <TextBlock x:Name="DbSizeText" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FlatButton}" Click="OpenDataDir_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFolder}"/>
                            <TextBlock Text="Abrir carpeta de datos" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- ===== Right: technical debug ===== -->
            <StackPanel Grid.Column="2">
                <TextBlock Text="Depuración técnica" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Sección avanzada para desarrollo." Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,12"/>

                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <StackPanel x:Name="RuntimeInfo"/>
                </Border>

                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Nivel de log" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LogLevelBox" Width="120" HorizontalAlignment="Left"
                              SelectionChanged="LogLevel_Changed"/>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Style="{StaticResource FlatButton}" Click="OpenLogs_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFile}"/>
                            <TextBlock Text="Abrir registros" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="CopyDiag_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconCopy}"/>
                            <TextBlock Text="Copiar diagnóstico" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Text="Eventos recientes" FontWeight="SemiBold" Margin="0,4,0,6"/>
                <Border Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="6" Height="220">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EventsList"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
