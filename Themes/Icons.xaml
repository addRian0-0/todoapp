<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Iconos de línea estilo Feather (viewBox 24x24, trazo).
        Se dibujan con Path para no depender de fuentes de emoji: WPF llama a
        Environment.FailFast si no encuentra una fuente para un glifo.
    -->

    <Style x:Key="IconPath" TargetType="Path">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Stroke" Value="{DynamicResource TextBrush}"/>
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <Style x:Key="IconPathSecondary" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
    </Style>

    <Style x:Key="IconPathAccentFg" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="White"/>
    </Style>

    <Style x:Key="IconPathDanger" TargetType="Path" BasedOn="{StaticResource IconPath}">
        <Setter Property="Stroke" Value="{DynamicResource DangerBrush}"/>
    </Style>

