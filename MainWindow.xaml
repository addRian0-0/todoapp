<Window x:Class="Notitas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notitas" Height="760" Width="1240" MinWidth="920" MinHeight="560"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI, Tahoma, Arial" FontSize="13"
        Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{DynamicResource WindowBg}">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="AppScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="234"/>
            <ColumnDefinition Width="306"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Barra lateral ============ -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBg}">
            <DockPanel Margin="12">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,4,0,14">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBook}"
                              Width="20" Height="20" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.9"/>
                        <TextBlock Text="Notitas" FontSize="18" FontWeight="SemiBold" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Style="{StaticResource AccentButton}" Click="NewNote_Click"
                            HorizontalAlignment="Stretch" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPathAccentFg}" Data="{StaticResource IconPlus}"/>
                            <TextBlock Text="Nueva nota" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavNotas" Style="{StaticResource FlatButton}"
                            HorizontalContentAlignment="Left" Click="NavNotas_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconFile}"/>
                            <TextBlock Text="Todas las notas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavArchivadas" Style="{StaticResource FlatButton}"
                            HorizontalContentAlignment="Left" Click="NavArchivadas_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconArchive}"/>
                            <TextBlock Text="Archivadas" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <DockPanel Margin="6,16,0,6">
                        <TextBlock Text="MATERIAS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource FlatButton}" ToolTip="Materias archivadas"
                                    Click="ArchivedSubjects_Click" Padding="6,3">
                                <Path Style="{StaticResource IconPathSecondary}" Data="{StaticResource IconArchive}"
                                      Width="14" Height="14"/>
                            </Button>
                            <Button Style="{StaticResource FlatButton}" ToolTip="Agregar materia"
                                    Click="AddSubject_Click" Padding="6,3">
                                <Path Style="{StaticResource IconPathSecondary}" Data="{StaticResource IconPlus}"
                                      Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>

                <Button DockPanel.Dock="Bottom" Style="{StaticResource FlatButton}"
                        HorizontalContentAlignment="Left" Click="Config_Click" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource IconPath}" Data="{StaticResource IconSettings}"/>
                        <TextBlock Text="Configuración" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- zoom de toda la aplicación -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBg}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="6,3" Margin="0,0,0,8">
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Style="{StaticResource IconPathSecondary}"
                              Data="{StaticResource IconZoom}" Width="14" Height="14"
                              VerticalAlignment="Center" Margin="2,0,0,0" ToolTip="Zoom de la aplicación"/>
                        <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="7,2"
                                Click="AppZoomIn_Click" ToolTip="Aumentar zoom de la app (Ctrl+Shift++)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}"
                                  Width="12" Height="12"/>
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource FlatButton}" Padding="7,2"
                                Click="AppZoomOut_Click" ToolTip="Reducir zoom de la app (Ctrl+Shift+-)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMinus}"
                                  Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="AppZoomLabel" Style="{StaticResource FlatButton}" Content="100 %"
                                FontSize="11" Padding="2,2" Click="AppZoomReset_Click"
                                ToolTip="Restablecer al 100 % (Ctrl+Shift+0)"/>
                    </DockPanel>
                </Border>

                <ListBox x:Name="SubjectList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         SelectionChanged="SubjectList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="6,5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Lista de notas ============ -->
        <Border Grid.Column="1" Background="{DynamicResource WindowBg}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0">
            <DockPanel Margin="10">
                <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" CornerRadius="8" Margin="0,0,0,10">
                    <Grid>
                        <DockPanel>
                            <Path Style="{StaticResource IconPathSecondary}" Data="{StaticResource IconSearch}"
                                  Width="14" Height="14" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="8,8"
                                     Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                     TextChanged="SearchBox_TextChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="SearchHint" Text="Buscar notas   ·   Ctrl+F" IsHitTestVisible="False"
                                   Margin="36,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}"/>
                    </Grid>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="4,0,2,8">
                    <TextBlock x:Name="ListHeader" Text="Todas las notas" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ListCount" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="EmptyListHint" DockPanel.Dock="Top" Visibility="Collapsed"
                           Text="No hay notas aquí todavía." Margin="4,6,0,0"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                <ListBox x:Name="NoteList" Background="Transparent" BorderThickness="0"
                         Foreground="{DynamicResource TextBrush}"
                         HorizontalContentAlignment="Stretch"
                         SelectionChanged="NoteList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,6"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" CornerRadius="8" Background="{DynamicResource CardBg}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                Padding="10,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectedBg}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ Editor ============ -->
        <Grid Grid.Column="2" Margin="18,10,18,10">
            <Grid x:Name="EditorPane" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Click="ExportDocx_Click"
                            ToolTip="Exportar esta nota a Word (.docx)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconExport}"/>
                            <TextBlock Text="Exportar Word" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,12,0">
                        <Path x:Name="SaveIcon" Style="{StaticResource IconPathSecondary}"
                              Data="{StaticResource IconCheck}" Width="14" Height="14"/>
                        <TextBlock x:Name="SaveState" Text="Guardado" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBox x:Name="TitleBox" FontSize="24" FontWeight="SemiBold" BorderThickness="0"
                             Background="Transparent" Foreground="{DynamicResource TextBrush}"
                             Margin="0,0,12,0" VerticalAlignment="Center"
                             CaretBrush="{DynamicResource TextBrush}" TextChanged="Editor_Changed"/>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="6,3" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Click="Heading_Click" ToolTip="Título de sección">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconHeading}"/>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Click="Bold_Click" ToolTip="Negrita (Ctrl+B)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconBold}"/>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Click="Italic_Click" ToolTip="Cursiva (Ctrl+I)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconItalic}"/>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Click="Underline_Click" ToolTip="Subrayado (Ctrl+U)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconUnderline}"/>
                        </Button>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>
                        <Button Style="{StaticResource FlatButton}" Click="Bullets_Click" ToolTip="Lista con viñetas">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconListBullet}"/>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Click="Numbers_Click" ToolTip="Lista numerada">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconListNumber}"/>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Click="Checklist_Click"
                                ToolTip="Checklist: convierte las líneas en casillas. Haz clic en la casilla para marcarla.">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconChecklist}"/>
                        </Button>
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>
                        <Button Style="{StaticResource FlatButton}" Click="Link_Click"
                                ToolTip="Insertar enlace en el texto seleccionado (Ctrl+clic para abrirlo)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconLink}"/>
                        </Button>

                        <!-- zoom de la nota abierta -->
                        <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="6,4"/>
                        <Path Style="{StaticResource IconPathSecondary}" Data="{StaticResource IconZoom}"
                              Width="14" Height="14" VerticalAlignment="Center" Margin="2,0,2,0"
                              ToolTip="Zoom de la nota"/>
                        <Button Style="{StaticResource FlatButton}" Padding="7,5" Click="NoteZoomOut_Click"
                                ToolTip="Reducir zoom de la nota (Ctrl+-)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconMinus}"
                                  Width="12" Height="12"/>
                        </Button>
                        <Button x:Name="NoteZoomLabel" Style="{StaticResource FlatButton}" Content="100 %"
                                FontSize="11" Padding="4,5" Click="NoteZoomReset_Click"
                                ToolTip="Restablecer la nota al 100 % (Ctrl+0)"/>
                        <Button Style="{StaticResource FlatButton}" Padding="7,5" Click="NoteZoomIn_Click"
                                ToolTip="Aumentar zoom de la nota (Ctrl++)">
                            <Path Style="{StaticResource IconPath}" Data="{StaticResource IconPlus}"
                                  Width="12" Height="12"/>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource CardBg}" CornerRadius="8"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <RichTextBox x:Name="Editor" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextBrush}" CaretBrush="{DynamicResource TextBrush}"
                                 Padding="14" FontSize="14" VerticalScrollBarVisibility="Auto"
                                 IsDocumentEnabled="True"
                                 TextChanged="Editor_Changed">
                        <RichTextBox.LayoutTransform>
                            <ScaleTransform x:Name="NoteScale" ScaleX="1" ScaleY="1"/>
                        </RichTextBox.LayoutTransform>
                    </RichTextBox>
                </Border>

                <DockPanel Grid.Row="3" Margin="2,8,2,0">
                    <TextBlock x:Name="MetaInfo" Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"/>
                    <ComboBox x:Name="NoteSubjectBox" DockPanel.Dock="Right" MinWidth="150"
                              HorizontalAlignment="Right" ToolTip="Materia de esta nota"
                              Background="{DynamicResource PanelBg}" Foreground="{DynamicResource TextBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              SelectionChanged="NoteSubjectBox_SelectionChanged"/>
                </DockPanel>
            </Grid>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Style="{StaticResource IconPathSecondary}" Data="{StaticResource IconFile}"
                      Width="40" Height="40" StrokeThickness="1.2" HorizontalAlignment="Center"/>
                <TextBlock Text="Selecciona o crea una nota para empezar" Margin="0,14,0,0"
                           Foreground="{DynamicResource TextSecondary}" FontSize="15"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
